{
  "name": "avatarka-react",
  "version": "4.0.0",
  "description": "Deterministic avatar rendering and picking for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "import": {
        "types": "./dist/styles.css.d.ts",
        "default": "./dist/styles.css"
      },
      "require": {
        "types": "./dist/styles.css.d.cts",
        "default": "./dist/styles.css"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": ["./dist/styles.css"],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "check:consumer": "tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution Bundler --noUncheckedSideEffectImports consumer/styles.ts && tsc --noEmit --strict --target ES2020 --module Node16 --moduleResolution Node16 --noUncheckedSideEffectImports consumer/styles.cts",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "avatarka": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": ["avatar", "svg", "generator", "react", "component"],
  "license": "MIT",
  "author": "Andrey Akinshin",
  "homepage": "https://github.com/AndreyAkinshin/avatarka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreyAkinshin/avatarka.git"
  },
  "bugs": {
    "url": "https://github.com/AndreyAkinshin/avatarka/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
